name: Deploy Viewer App

on:
  push:
    branches:
      - main  # Triggers when you push changes to the main branch

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Pages
        uses: actions/configure-pages@v4

      - name: Upload Repository Files
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.'  # Uploads all files in your viewer repo

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
 